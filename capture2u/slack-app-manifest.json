{
	"display_information": {
		"name": "Capture2u",
		"description": "Plays Capture2u recordings inside Slack",
		"background_color": "#1d4ed8"
	},
	"features": {
		"bot_user": {
			"display_name": "Capture2u",
			"always_online": false
		},
		"unfurl_domains": ["capture2u.locate2u.com"]
	},
	"oauth_config": {
		"scopes": {
			"bot": ["links:read", "links:write", "links.embed:write"]
		}
	},
	"settings": {
		"event_subscriptions": {
			"request_url": "https://capture2u.locate2u.com/api/slack/events",
			"bot_events": ["link_shared"]
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
