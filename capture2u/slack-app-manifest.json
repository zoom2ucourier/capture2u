{
	"display_information": {
		"name": "Capture2u",
		"description": "Plays Capture2u recordings in Slack and tells you when they are watched",
		"background_color": "#1d4ed8"
	},
	"features": {
		"bot_user": {
			"display_name": "Capture2u",
			"always_online": false
		},
		"unfurl_domains": ["capture.locate2u.io"]
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"links:read",
				"links:write",
				"links.embed:write",
				"chat:write",
				"users:read",
				"users:read.email"
			]
		}
	},
	"settings": {
		"event_subscriptions": {
			"request_url": "https://capture.locate2u.io/api/slack/events",
			"bot_events": ["link_shared"]
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
