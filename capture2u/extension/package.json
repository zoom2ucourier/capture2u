{
	"name": "capture2u-extension",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"license": "AGPL-3.0-only",
	"scripts": {
		"build": "node scripts/clean.mjs && vite build && vite build --config vite.content.config.ts && vite build --config vite.content-overlay.config.ts",
		"icons": "node scripts/generate-icons.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run src",
		"package": "npm run build && node scripts/package.mjs",
		"test:e2e": "node e2e/run.mjs"
	},
	"dependencies": {
		"@radix-ui/colors": "3.0.0",
		"@radix-ui/react-select": "2.3.2",
		"@radix-ui/react-switch": "1.3.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "0.525.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"tailwind-merge": "2.6.1"
	},
	"devDependencies": {
		"@types/chrome": "0.0.323",
		"@types/jsdom": "21.1.7",
		"@types/node": "22.15.3",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.4.1",
		"autoprefixer": "10.5.2",
		"fflate": "0.8.2",
		"jsdom": "26.1.0",
		"playwright-core": "1.61.1",
		"postcss": "8.5.23",
		"tailwindcss": "3.4.19",
		"tailwindcss-animate": "1.0.7",
		"typescript": "5.9.3",
		"vite": "6.4.5",
		"vitest": "3.2.6"
	}
}
