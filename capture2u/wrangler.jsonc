{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "capture2u",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/media/*", "/v/*"]
	},
	"r2_buckets": [{ "binding": "VIDEOS", "bucket_name": "capture2u-videos" }],
	"ai": { "binding": "AI" },
	"send_email": [{ "name": "EMAIL" }],
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "capture2u-jobs" }],
		"consumers": [
			{ "queue": "capture2u-jobs", "max_batch_size": 1, "max_retries": 3 }
		]
	},
	"workers_dev": true,
	"routes": [{ "pattern": "capture.locate2u.io", "custom_domain": true }],
	"triggers": { "crons": ["0 16 * * *"] },
	// The database and the video bucket are both in Sydney. Running the Worker
	// beside them, wherever the person is, makes every call that touches them
	// faster.
	"placement": { "mode": "smart" },
	"observability": { "enabled": true },
	// Rewriting a long recording into a seekable file is steady CPU work.
	"limits": { "cpu_ms": 300000 },
	// Variables and secrets added in the Cloudflare dashboard are kept on every
	// deploy. Only the two public Supabase values are set here; a name listed
	// here would overwrite a dashboard value of the same name.
	"keep_vars": true,
	"vars": {
		"SUPABASE_URL": "https://frbjfigqvxosswdhdjqi.supabase.co",
		"SUPABASE_ANON_KEY": "sb_publishable_MgIYtp2z391wb4ad7c1ZSg_1Sx4x6_B"
	}
}
