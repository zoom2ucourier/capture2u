# Capture2u production settings.
# Copy to .env on the server and fill in. Never commit .env.
# Generate each secret marked "random" with:  openssl rand -hex 32

# --- Site ---------------------------------------------------------------
CAPTURE2U_URL=https://capture2u.locate2u.com

# Our fork's website image, built by the "Docker Build Web" GitHub Action.
CAPTURE2U_WEB_IMAGE=ghcr.io/zoom2ucourier/cap-web:c2u-YYYYMMDD
# Cap's media server, unchanged. Pin the digest after the first pull.
CAPTURE2U_MEDIA_SERVER_IMAGE=ghcr.io/capsoftware/cap-media-server:latest

# --- Secrets (random) -----------------------------------------------------
NEXTAUTH_SECRET=
# Keep a copy in the password manager. Backups cannot be read without it.
DATABASE_ENCRYPTION_KEY=
MEDIA_SERVER_WEBHOOK_SECRET=
CRON_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Cloudflare -----------------------------------------------------------
# Tunnel token from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# R2 video bucket (private). Token scoped to this bucket, Object Read & Write.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=capture2u-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 backup bucket (private). Separate token scoped to this bucket.
BACKUP_R2_BUCKET=capture2u-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Random. Keep a copy in the password manager. Needed to restore a backup.
BACKUP_ENCRYPTION_PASSPHRASE=

# --- Who can sign up ------------------------------------------------------
# Exact domains only. Sub-domains must be listed separately.
CAP_ALLOWED_SIGNUP_DOMAINS=zoom2u.com,locate2u.com,locatetech.nz,freightmatch.com.au
# Domains or full addresses to lock out, e.g. leavers.
CAP_BLOCKED_SIGNUP_DOMAINS=
# true = anyone with the link can view (matches Loom).
CAP_VIDEOS_DEFAULT_PUBLIC=true
# The Chrome Web Store ID of the Cap extension. Leave as is.
CAP_CHROME_EXTENSION_ID=fefjaffcodfiogbbngmjkcjpbpclbdcp

# --- Sign in with Google --------------------------------------------------
# OAuth client with redirect URI:
#   https://capture2u.locate2u.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ----------------------------------------------------------------
# "ses" sends through Amazon SES. Leave empty to fall back to Resend below.
CAPTURE2U_EMAIL_PROVIDER=ses
CAPTURE2U_SES_REGION=ap-southeast-2
# IAM user allowed ses:SendEmail only.
CAPTURE2U_SES_ACCESS_KEY_ID=
CAPTURE2U_SES_SECRET_ACCESS_KEY=
# Must be an address or domain verified in SES.
CAPTURE2U_EMAIL_FROM=Capture2u <no-reply@locate2u.com>
# Fallback only, if CAPTURE2U_EMAIL_PROVIDER is empty.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=

# --- Transcripts and AI ---------------------------------------------------
ASSEMBLY_API_KEY=
GROQ_API_KEY=

# --- View counts (Tinybird) -----------------------------------------------
TINYBIRD_HOST=
TINYBIRD_TOKEN=

# --- Slack (play videos inside Slack) -------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- Retention ------------------------------------------------------------
# report = only list what would be deleted. delete = actually delete.
CAPTURE2U_RETENTION_MODE=report
CAPTURE2U_RETENTION_DAYS=365
CAPTURE2U_RETENTION_MAX_PER_RUN=200

# --- Schedule (UTC). 16:00 UTC is 2am or 3am in Sydney. ---------------------
BACKUP_AT_UTC=16:00
RETENTION_AT_UTC=17:00
